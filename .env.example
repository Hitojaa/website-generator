# Copiez ce fichier en .env.local et remplissez les valeurs
# Ne commitez jamais .env.local dans le dépôt Git

# URL du site en production (obligatoire pour le SEO)
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.fr

# Email de destination pour le formulaire de contact
# Assurez-vous de sécuriser votre endpoint d'envoi côté serveur
CONTACT_EMAIL=contact@votre-domaine.fr

# Optionnel : clé API pour un service d'envoi d'emails (ex: Resend, SendGrid)
# EMAIL_API_KEY=

# Optionnel : ID Google Analytics
# NEXT_PUBLIC_GA_ID=

# Optionnel : Google Maps Embed API Key
# NEXT_PUBLIC_GMAPS_KEY=
